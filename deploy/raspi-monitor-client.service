[Unit]
Description=Raspberry Pi monitor TUI (auto-start on tty1)
After=network-online.target getty@tty1.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=samuel
Environment=TERM=linux
Environment=COLUMNS=60
Environment=LINES=40
WorkingDirectory=/home/samuel/raspberry-py-moniter
ExecStart=/home/samuel/raspberry-py-moniter/.venv/bin/python -m client.tui --host 192.168.1.120 --port 8000
Restart=always
RestartSec=3
StandardInput=tty
StandardOutput=journal
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=multi-user.target
